"t13\stm32f1xx_hal_uart.o"
"t13\stm32f1xx_hal.o"
"t13\stm32f1xx_hal_rcc.o"
"t13\stm32f1xx_hal_rcc_ex.o"
"t13\stm32f1xx_hal_gpio.o"
