--cpu Cortex-M3
"t-1-12\startup_stm32f103xe.o"
"t-1-12\main.o"
"t-1-12\gpio.o"
"t-1-12\tim.o"
"t-1-12\stm32f1xx_it.o"
"t-1-12\stm32f1xx_hal_msp.o"
"t-1-12\stm32f1xx_hal_gpio_ex.o"
"t-1-12\stm32f1xx_hal_tim.o"
"t-1-12\stm32f1xx_hal_tim_ex.o"
"t-1-12\stm32f1xx_hal.o"
"t-1-12\stm32f1xx_hal_rcc.o"
"t-1-12\stm32f1xx_hal_rcc_ex.o"
"t-1-12\stm32f1xx_hal_gpio.o"
"t-1-12\stm32f1xx_hal_dma.o"
